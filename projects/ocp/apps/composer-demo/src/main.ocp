module apps.composer_demo.main;
import generated.mod;

observe("std.fs.read", "tier2", ctx("path=README.md"), budget(5)) -> file_res;
match file_res {
  OK => { let ready = true; condition(ready); }
  DEGRADED => { let ready = true; condition(ready); }
  INSUFFICIENT => { let ready = true; condition(ready); }
  DEFERRED => { let ready = true; condition(ready); }
}

condition(true);
