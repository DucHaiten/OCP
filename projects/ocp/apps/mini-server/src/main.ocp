module apps.mini_server.main;

fn on_event(event) {
  observe("std.net.listen", "tier2", ctx("addr=127.0.0.1:19091"), budget(5)) -> listen_res;
  match listen_res {
    OK => { let listening = true; condition(listening); }
    DEGRADED => { let listening = true; condition(listening); }
    INSUFFICIENT => { let listening = true; condition(listening); }
    DEFERRED => { let listening = true; condition(listening); }
  }

  observe("std.net.reply", "tier2", ctx("conn=local;status=200;body=ok"), budget(5)) -> reply_res;
  commit(reply_res);

  observe("std.log.info", "tier2", ctx("message=mini-server"), budget(5)) -> log_res;
  match log_res {
    OK => { let logged = true; condition(logged); }
    DEGRADED => { let logged = true; condition(logged); }
    INSUFFICIENT => { let logged = true; condition(logged); }
    DEFERRED => { let logged = true; condition(logged); }
  }
  return event;
}

let boot = true;
condition(boot);
