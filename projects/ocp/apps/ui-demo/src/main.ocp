module apps.ui_demo;

observe("std.log.info", "tier2", ctx("msg=ui-demo-boot"), budget(5)) -> log_res;
match log_res {
  OK => { let stable = true; }
  DEGRADED => { let stable = true; }
  INSUFFICIENT => { let stable = true; }
  DEFERRED => { let stable = true; }
}

let ready = true;
condition(ready);
