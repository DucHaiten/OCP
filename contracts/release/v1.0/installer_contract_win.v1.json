{
  "schema": "ocl.release.installer_contract_win.v1",
  "contract_id": "v1.installer_contract_win",
  "version": "v1",
  "installer_filename": "ocl-v1.0.0-setup-win-x64.exe",
  "installer_icon_asset": "installer/windows/ocl-installer.ico",
  "default_install_path": "C:\\Program Files\\OCP-OCL\\",
  "supports_install_dir_choice": true,
  "supports_add_to_path": true,
  "supports_add_to_path_confirmation": true,
  "add_to_path_scope": "system",
  "bundles_vscode_vsix": true,
  "supports_vscode_auto_install": true,
  "vscode_install_log_filename": "vscode-extension-install.log",
  "vscode_detection_modes": [
    "program_files",
    "local_appdata",
    "path_lookup_absolute"
  ],
  "vscode_manual_fallback_command": "code --install-extension ocp-ocl-vscode-v1.0.0.vsix --force",
  "supports_uninstall": true,
  "post_install_checks": [
    "ocl --version",
    "ocl init hello"
  ]
}
